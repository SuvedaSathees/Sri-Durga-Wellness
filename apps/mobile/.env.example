# Copy to .env and adjust. EXPO_PUBLIC_* values are bundled into the app and readable by anyone
# who has it, so never put passwords, API secrets or payment credentials here.

EXPO_PUBLIC_APP_ENV=development

# "mock" uses the built-in sample backend; "live" calls EXPO_PUBLIC_API_BASE_URL.
EXPO_PUBLIC_API_MODE=mock

# Required for live mode; must be https (http allowed for localhost / 10.0.2.2 during development).
# Android emulator: http://10.0.2.2:4000/v1 reaches a backend on your computer.
# EXPO_PUBLIC_API_BASE_URL=https://api.example.com/v1

# EXPO_PUBLIC_API_TIMEOUT_MS=15000
# EXPO_PUBLIC_MOCK_LATENCY_MS=350

# Mock mode only: "on" shows the sample-content notice on the Home screen. Off by default.
# EXPO_PUBLIC_PREVIEW_UI=on
