{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal", "env": { "EXPO_PUBLIC_API_MODE": "mock" } },
    "preview": { "distribution": "internal", "env": { "EXPO_PUBLIC_APP_ENV": "staging" } },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_APP_ENV": "production", "EXPO_PUBLIC_API_MODE": "live" }
    }
  },
  "submit": { "production": {} }
}
