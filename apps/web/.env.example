# Copy to .env.local and adjust. Every VITE_* value is public (it ends up in the browser bundle),
# so never put passwords, API secrets or payment credentials here.

# development | staging | production
VITE_APP_ENV=development

# "mock" uses the built-in sample backend (no server needed).
# "live" calls your backend at VITE_API_BASE_URL.
VITE_API_MODE=mock

# Base URL of the REST API, including the version prefix. Required when VITE_API_MODE=live.
# Must be https (http is allowed for localhost only).
# VITE_API_BASE_URL=https://api.example.com/v1

# Request timeout in milliseconds (default 15000).
# VITE_API_TIMEOUT_MS=15000

# Artificial delay for mock responses so loading states are visible (default 350).
# VITE_MOCK_LATENCY_MS=350

# Mock mode only: "on" shows the sample-content banner and the Demo tools button (sign in as a
# sample customer, act as clinic staff verifying a payment). Off by default. The browser tests
# turn it on through .env.test.
# VITE_PREVIEW_UI=on
